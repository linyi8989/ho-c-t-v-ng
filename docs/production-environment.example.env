# PRODUCTION CONFIGURATION TEMPLATE — Node.js 22.x; startup file app.js.
# This file is documentation, NOT loaded automatically.
# Fill placeholders privately; do not commit a filled copy.
# Keep existing production DB/media paths and existing identity/ticket secrets.
# Paths below match .cpanel.yml; change them only if your host uses other paths.

# BUILD MACHINE: place these Firebase web settings in .env.production BEFORE npm run build.
# Changing VITE_* on cPanel alone does not change an already built client.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_LAZY_SESSION_V3=true
VITE_LOCAL_AUTH_BYPASS_ENABLED=false

# SERVER: set these in cPanel Node.js Application Environment, then restart the app.
# If Passenger manages PORT, keep its provided value rather than overriding it.
NODE_ENV=production
# PORT=3000
# Set the actual number of reverse-proxy hops; 0 for direct access.
TRUST_PROXY_HOPS=0
LOCAL_AUTH_BYPASS_ENABLED=false
SEED_DATA_ENABLED=false

# Firebase Admin authenticates real users even when application data uses SQLite.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_SERVICE_ACCOUNT_EMAIL
# One line: use literal \n between PEM lines, as expected by firebaseAdmin.ts.
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY
# Same Firebase web API key, used by backend account/auth endpoints.
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
BOOTSTRAP_SUPER_ADMIN_EMAILS=YOUR_ADMIN_EMAIL

# Persistent storage: use the existing database; do not point to an empty replacement.
STORAGE_MODE=sqlite
SQLITE_DRIVER=better-sqlite3
SQLITE_DB_PATH=/home/qzmivzbj/app-data/vhomework/app.sqlite
SQLITE_ALLOW_CREATE=false
SQLITE_ALLOW_JSON_IMPORT=false
SQLITE_BUSY_TIMEOUT_MS=10000
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_SLOW_QUERY_MS=250
SQLITE_STATEMENT_CACHE_SIZE=200
SQLITE_BACKUP_DIR=/home/qzmivzbj/app-data/vhomework/backups
TTS_AUDIO_DIR=/home/qzmivzbj/app-data/vhomework/audio
LISTENING_MEDIA_DIR=/home/qzmivzbj/app-data/vhomework/listening-media
VOCAB_IMAGE_DIR=/home/qzmivzbj/app-data/vhomework/vocab-images
# Speaking recordings use speaking-recordings beside SQLITE_DB_PATH; no extra env variable.

# Keep each existing secret unchanged. For a new installation, create independent random secrets.
DIAGNOSTIC_SECRET=YOUR_EXISTING_DIAGNOSTIC_SECRET
GUEST_PUBLIC_ID_SECRET=YOUR_EXISTING_GUEST_ID_SECRET
LISTENING_TICKET_SECRET=YOUR_EXISTING_LISTENING_TICKET_SECRET

# Student features / history.
LEARNING_HISTORY_ENABLED=true
IOE_VIOLYMPIC_ENABLED=true
SPEAKING_ENABLED=true
LAZY_SESSION_V3_ENABLED=true
LEADERBOARD_ALLOW_LEGACY_FALLBACK=false
RECENT_ACTIVITY_DAYS=7
ATTEMPT_DETAIL_RETENTION_DAYS=30
LEGACY_GUEST_SESSION_MAX_AGE_HOURS=24
GUEST_ACTIVITY_TOUCH_INTERVAL_MS=300000
GAME_ACTION_BATCH_MAX_ITEMS=50
SLOW_API_LOG_MS=500

# AI providers: fill only the keys for providers you actually use; others may stay empty.
# All keys in this section are SERVER ONLY, never VITE_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
STALI_API_KEY=
STALI_BASE_URL=https://api.stali.vn/v1
DEVQUOTA_API_KEY=
DEVQUOTA_BASE_URL=https://sv.devquote.shop/v1
SEEDVIS_API_KEY=
SEEDVIS_BASE_URL=https://seedvis.com/api/v1

# Exam authoring / vocabulary images.
LISTENING_SMART_IMPORT_ENABLED=true
LISTENING_SMART_IMPORT_TIMEOUT_MS=180000
VOCAB_IMAGE_GENERATION_TIMEOUT_MS=120000
VOCAB_IMAGE_DOWNLOAD_TIMEOUT_MS=30000
VOCAB_IMAGE_MAX_BYTES=8388608
VOCAB_IMAGE_BATCH_CONCURRENCY_PER_PROVIDER=50
VOCAB_IMAGE_BATCH_TOTAL_CONCURRENCY=8
VOCAB_IMAGE_BATCH_MAX_ITEMS=500

# Vocabulary TTS / legacy B audio generation: select the provider in the UI.
# AI33 accepts AI33_API_KEY or the older TTS_API_KEY alias; only one is needed.
AI33_API_KEY=
# TTS_API_KEY=
AI33_TASK_STATUS_URL_TEMPLATE=https://api.ai33.pro/v1/task/{taskId}
AI33_TTS_POLL_ATTEMPTS=24
AI33_TTS_POLL_INTERVAL_MS=2500
YUPVOX_API_KEY=
YUPVOX_BASE_URL=https://api.yupvox.com
YUPVOX_TTS_POLL_ATTEMPTS=40
YUPVOX_TTS_POLL_INTERVAL_MS=1500
TTS_FETCH_TIMEOUT_MS=30000
TTS_MAX_AUDIO_BYTES=3145728
TTS_CONCURRENCY=5

# Speaking pronunciation assessment through Azure.
AZURE_SPEECH_KEY=YOUR_AZURE_SPEECH_KEY
# Region code from the same Azure Speech resource, e.g. southeastasia.
AZURE_SPEECH_REGION=YOUR_AZURE_RESOURCE_REGION
# Optional prosody assessment. Keep true if your current setup already uses it.
SPEAKING_AZURE_PROSODY=false
SPEAKING_DAILY_LIMIT=20
SPEAKING_AUDIO_RETENTION_DAYS=1

# Speaking generated sample audio: azure or b. Browser/device speech needs no extra key.
SPEAKING_SAMPLE_TTS_PROVIDER=azure
SPEAKING_AZURE_TTS_VOICE_EN_US=en-US-JennyNeural
SPEAKING_AZURE_TTS_VOICE_EN_GB=en-GB-SoniaNeural

# Optional SpeechSuper provider; fill both only if lessons use SpeechSuper.
SPEECHSUPER_APP_KEY=
SPEECHSUPER_SECRET_KEY=

# Speaking AI feedback: devquota / stali / gemini / none.
# This preset needs DEVQUOTA_API_KEY above. Stali uses STALI_API_KEY.
# Gemini needs GEMINI_API_KEY and an explicitly supported SPEAKING_FEEDBACK_MODEL.
# For DevQuota/Stali use metrics. none disables just AI feedback, not Azure grading.
SPEAKING_FEEDBACK_PROVIDER=devquota
SPEAKING_FEEDBACK_MODEL=gpt-5.6-sol
SPEAKING_FEEDBACK_MODE=metrics

# Intentionally omitted: VITE_LEARNING_HISTORY_ENABLED (retired), DRAFT_RETENTION_DAYS
# (unused), DEVQUOTA_API_KEYk (deprecated), legacy JSON import paths, local test/debug flags.
# No UI-theme, queue-limit or Azure-timeout env variables are needed for the recent changes.

# Storage & Maintenance Center (server only; never use VITE_ for credentials).
# Persistent metadata stays outside DEPLOYPATH. Existing DB/media paths are unchanged.
MAINTENANCE_ACCOUNT_ROOT=/home/qzmivzbj
MAINTENANCE_DEPLOY_ROOT=/home/qzmivzbj/app.msdieu.com
MAINTENANCE_STATE_DIR=/home/qzmivzbj/app-data/vhomework/maintenance
MAINTENANCE_MAX_FILES=100000
MAINTENANCE_SCAN_SECONDS=60
MAINTENANCE_RESERVE_MB=256
# Optional read-only quota integration. Leave blank until configured privately.
# Hostname only, using HTTPS port 2083. No cPanel credentials reach the client.
MAINTENANCE_CPANEL_HOST=
MAINTENANCE_CPANEL_USER=
MAINTENANCE_CPANEL_TOKEN=
# Optional crontab -l discovery; this never registers or changes cron.
MAINTENANCE_CRON_DISCOVERY=false
# For a separately configured cron process only:
# MAINTENANCE_ENV_FILE=/home/qzmivzbj/app-data/vhomework/maintenance.env
# Local verification permits deleting the last host backup. No retention-count setting.
# Temp/Speaking automation defaults OFF and needs super admin opt-in + external cron.
# No R2/Azure/email integration is activated by these variables.

# Whole-account V1 inventory. Opt-in process executor only after a read-only host pilot.
# Blank means dashboard reports executor unconfigured; CLI can still be invoked explicitly.
MAINTENANCE_INVENTORY_EXECUTOR=
MAINTENANCE_INVENTORY_BUDGET_MB=128
MAINTENANCE_INVENTORY_FREE_MB=32
MAINTENANCE_INVENTORY_MEMORY_MB=256
MAINTENANCE_INVENTORY_BATCH=100
MAINTENANCE_INVENTORY_BATCH_MS=250
MAINTENANCE_INVENTORY_DELAY_MS=50
MAINTENANCE_INVENTORY_WINDOW_SECONDS=60
MAINTENANCE_INVENTORY_TIMEZONE=Asia/Bangkok
MAINTENANCE_INVENTORY_GROWTH_MB=100
MAINTENANCE_INVENTORY_GROWTH_PERCENT=20
# These only read metadata. No application/cron/process mutation.
MAINTENANCE_NODE_SELECTOR_DISCOVERY=false
MAINTENANCE_PROCESS_DISCOVERY=false