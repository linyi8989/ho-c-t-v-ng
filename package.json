{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node app.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:identity": "tsx --test src/lib/guestIdentity.test.ts",
    "test:grammar": "tsx --test src/lib/grammarAnswers.test.ts",
    "test:listening": "tsx --test src/server/listening/listeningGrader.test.ts src/server/listening/listeningStorage.test.ts src/server/listening/listeningRouterCompatibility.test.ts src/server/listening-library/router.test.ts src/features/listening-library/registry.test.ts",
    "test:runs": "tsx --test src/lib/learningRuns.test.ts src/lib/serverLearningRuns.test.ts",
    "test:storage": "tsx --test src/lib/sqliteStorage.test.ts src/lib/learningHistoryStorage.test.ts",
    "test:history:unit": "tsx --test src/lib/api/learningHistory.test.ts src/lib/leaderboard.test.ts src/server/publicStudentIdentity.test.ts src/server/learning-history/learningHistory.test.ts src/server/learning-history/learningHistoryApi.test.ts",
    "test:history:cli": "node scripts/test-learning-history-cli.mjs",
    "test:legacy-contracts": "tsx --test src/server/legacyContracts.integration.test.ts",
    "test:history": "npm run test:storage && npm run test:history:unit && npm run test:history:cli",
    "test:startup": "node scripts/smoke-storage-startup.mjs",
    "test:phase1": "npm run lint && npm run test:identity && npm run test:grammar && npm run test:runs && npm run test:storage && npm run build && npm run test:startup",
    "test:phase2": "npm run test:phase1 && npm run test:history:unit && npm run test:history:cli && npm run test:legacy-contracts",
    "storage:preflight": "node scripts/sqlite-preflight.mjs",
    "db:preflight": "node scripts/sqlite-preflight.mjs",
    "db:diagnostics": "node scripts/sqlite-diagnostics.mjs",
    "db:backup": "node scripts/sqlite-backup.mjs",
    "db:checkpoint": "node scripts/sqlite-checkpoint.mjs",
    "db:prepare-sqljs-rollback": "node scripts/sqlite-prepare-sqljs-rollback.mjs",
    "db:backfill-learning-history": "node scripts/db-backfill-learning-history.mjs",
    "maintenance:activity-prune": "node scripts/activity-prune.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "10.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
