DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  SetEnvIf Request_URI "^/assets/" immutable_asset
  Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_filter.c>
  AddOutputFilterByType DEFLATE application/json application/javascript text/css text/html text/plain text/xml image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^api(?:/|$) - [L]
  RewriteRule ^(?:assets|audio|listening-media|vocab-images)(?:/|$) - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^$ /index.html [L]
  RewriteRule ^(?:history|reg|register|login|admin)/?$ /index.html [L]
  RewriteRule ^(?:assignment/[^/]+|vocabulary/private/[^/]+|grammar/private/[^/]+)/?$ /index.html [L]
  RewriteRule ^teacher-preview/(?:vocabulary|grammar)/[^/]+/?$ /index.html [L]
  RewriteRule ^exams(?:/[^/]+){0,3}/?$ /index.html [L]
  RewriteRule ^listening(?:/[^/]+){0,6}/?$ /index.html [L]
  RewriteRule ^writing/[^/]+/?$ /index.html [L]
</IfModule>
