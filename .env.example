VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_LAZY_SESSION_V3=true
LAZY_SESSION_V3_ENABLED=true
LEARNING_HISTORY_ENABLED=false
# Local auth bypass is intentionally absent here. Use `npm run dev:local`; never enable it on a host.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Backend-only key for Stali Vision and vocabulary image generation.
STALI_API_KEY=
STALI_BASE_URL=https://api.stali.vn/v1
# Backend-only key for DevQuota Vision and vocabulary image generation.
DEVQUOTA_API_KEY=
DEVQUOTA_BASE_URL=https://sv.devquote.shop/v1
# Backend-only Seedvis key for exactly two enabled image models:
# NARWHAL (Google Nano Banana 2) and GEM_PIX_2 (Google Nano Banana Pro).
SEEDVIS_API_KEY=
SEEDVIS_BASE_URL=https://seedvis.com/api/v1
# Comma-separated bootstrap accounts. Existing backend roles and Firebase
# custom claims remain authoritative; never hard-code real emails in source.
BOOTSTRAP_SUPER_ADMIN_EMAILS=
# Number of reverse-proxy hops in front of Express. Use 0 when directly exposed.
TRUST_PROXY_HOPS=0
STORAGE_MODE=sqlite
SQLITE_DRIVER=better-sqlite3
SQLITE_DB_PATH=/srv/vhomework/app.sqlite
SQLITE_ALLOW_CREATE=false
SQLITE_ALLOW_JSON_IMPORT=false
SQLITE_BUSY_TIMEOUT_MS=10000
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_SLOW_QUERY_MS=250
SQLITE_STATEMENT_CACHE_SIZE=200
SQLITE_BACKUP_DIR=/srv/vhomework/backups
RECENT_ACTIVITY_DAYS=7
ATTEMPT_DETAIL_RETENTION_DAYS=30
# Reserved for a future draft/checkpoint workflow; current Release B code does not read it.
DRAFT_RETENTION_DAYS=3
SEED_DATA_ENABLED=false
LOCAL_DB_PATH=/srv/vhomework/db.json
# Optional path-delimited legacy JSON locations used only by the explicit import migration.
LEGACY_JSON_IMPORT_PATHS=
DIAGNOSTIC_SECRET=
GUEST_PUBLIC_ID_SECRET=
AI33_API_KEY=
TTS_API_KEY=
# Dedicated backend-only key from https://yupvox.com/api-keys
YUPVOX_API_KEY=
YUPVOX_BASE_URL=https://api.yupvox.com
YUPVOX_TTS_POLL_ATTEMPTS=40
YUPVOX_TTS_POLL_INTERVAL_MS=1500
TTS_AUDIO_DIR=/srv/vhomework/audio
LISTENING_MEDIA_DIR=/srv/vhomework/listening-media
# Persistent managed image storage. Required in production.
VOCAB_IMAGE_DIR=/srv/vhomework/vocab-images
# AI generation and local-upload controls. All provider keys stay backend-only.
# Stali uses req/gpt-image-2; DevQuota uses gpt-image-2; Seedvis exposes only the two models above. Restart after changing keys.
VOCAB_IMAGE_GENERATION_TIMEOUT_MS=120000
VOCAB_IMAGE_DOWNLOAD_TIMEOUT_MS=30000
VOCAB_IMAGE_MAX_BYTES=8388608
# Batch sends the whole vocabulary list once, with an independent cap per configured provider.
VOCAB_IMAGE_BATCH_CONCURRENCY_PER_PROVIDER=50
VOCAB_IMAGE_BATCH_MAX_ITEMS=500
# Temporary compatibility only for tokenless guest game tabs created before
# session-token rollout. Set 0 after the transition window.
LEGACY_GUEST_SESSION_MAX_AGE_HOURS=24
# HMAC secret for signed Listening attempt tickets (64+ random hex characters).
LISTENING_TICKET_SECRET=
# Set false to disable every Listening Smart Import analysis path without affecting the manual editor.
LISTENING_SMART_IMPORT_ENABLED=true
# Total backend deadline for one Smart Import request; clamped to 15-180 seconds.
LISTENING_SMART_IMPORT_TIMEOUT_MS=180000
AI33_TASK_STATUS_URL_TEMPLATE=https://api.ai33.pro/v1/task/{taskId}
SLOW_API_LOG_MS=500
GAME_ACTION_BATCH_MAX_ITEMS=50
GUEST_ACTIVITY_TOUCH_INTERVAL_MS=300000
