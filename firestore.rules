rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // User profiles are created and updated by the backend Admin SDK.
    // Clients may read only their own profile and cannot write role/status.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Runtime/admin-managed collections must be written through backend APIs.
    // Backend Firebase Admin bypasses these rules.
    match /vocab_sets/{setId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /classes/{classId} {
      allow read: if false;
      allow write: if false;
    }

    match /class_members/{memberId} {
      allow read: if false;
      allow write: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if false;
      allow write: if false;
    }

    match /game_sessions/{sessionId} {
      allow read: if false;
      allow write: if false;
    }

    match /grammar_sets/{setId} {
      allow read: if false;
      allow write: if false;
    }

    match /grammar_attempts/{attemptId} {
      allow read: if false;
      allow write: if false;
    }

    match /pronunciation_attempts/{attemptId} {
      allow read: if false;
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
